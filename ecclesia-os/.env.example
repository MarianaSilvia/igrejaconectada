# Demo uses local embedded PostgreSQL and fictional records. Never use real data.
APP_MODE=demo
PORT=3100
PUBLIC_ORIGIN=http://localhost:3100
# Production requires PostgreSQL, separate migration/runtime users and a 32-byte hex key.
# DATABASE_URL=postgresql://ecclesia_runtime:password@localhost:5432/ecclesia
# SERVICE_DATABASE_URL=postgresql://ecclesia_service_runtime:other-password@localhost:5432/ecclesia
# MIGRATION_DATABASE_URL=postgresql://migration_owner:password@localhost:5432/ecclesia
# DATA_KEY_HEX=
# MFA_KEY_HEX=
# RUN_INTEGRATION_WORKER=false
# Communication stays disabled until a provider is homologated. Webhook payloads contain only the opted-in address and message content.
# COMMUNICATION_TRANSPORT=disabled
# COMMUNICATION_EMAIL_WEBHOOK=https://provider.example/email
# COMMUNICATION_SMS_WEBHOOK=https://provider.example/sms
# COMMUNICATION_WEBHOOK_TOKEN=
# COMMUNICATION_CALLBACK_TOKEN=use-a-different-secret-of-at-least-16-characters
# EFI_CONFIG_PATH=/absolute/private/path/efi-accounts.json
# EFI_WEBHOOK_CA_PATH=/absolute/private/path/efi-ca.pem
# EFI_TLS_CERT_PATH=/absolute/private/path/server.pem
# EFI_TLS_KEY_PATH=/absolute/private/path/server-key.pem
# PUBLIC_ORIGIN=https://ecclesia.example.org:3443
# IPv4 shared pooler (copy the exact host from Supabase > Connect > Session pooler).
# Custom roles use the project reference in the username:
# DATABASE_URL=postgresql://ecclesia_app.<project-ref>:<password>@<copied-pooler-host>:5432/postgres?sslmode=require&uselibpqcompat=true
# SERVICE_DATABASE_URL=postgresql://ecclesia_service.<project-ref>:<password>@<copied-pooler-host>:5432/postgres?sslmode=require&uselibpqcompat=true
# MIGRATION_DATABASE_URL=postgresql://ecclesia_migration.<project-ref>:<password>@<copied-pooler-host>:5432/postgres?sslmode=require&uselibpqcompat=true

# Optional for external PostgreSQL smoke test; copy host from Supabase Connect.
# SUPABASE_PROJECT_REF=vsqumzgcbkeiiokpwdzm
# SUPABASE_POOLER_HOST=aws-0-<region>.pooler.supabase.com
# SUPABASE_POOLER_PORT=5432
