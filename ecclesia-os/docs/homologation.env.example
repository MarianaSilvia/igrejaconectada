# Copie para um gerenciador de segredos; não use este arquivo diretamente em produção.
APP_MODE=homologation
PUBLIC_ORIGIN=https://app.exemplo.invalid
ALLOWED_ORIGINS=https://app.exemplo.invalid

# Cada URL deve usar um login separado, sem compartilhar o snapshot local.
DATABASE_URL=postgresql://ecclesia_app:REPLACE@db.exemplo.invalid:5432/ecclesia
SERVICE_DATABASE_URL=postgresql://ecclesia_service:REPLACE@db.exemplo.invalid:5432/ecclesia
MIGRATION_DATABASE_URL=postgresql://ecclesia_migration:REPLACE@db.exemplo.invalid:5432/ecclesia

# Gere valores distintos de 32 bytes em hexadecimal usando um cofre de segredos.
DATA_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS
MFA_KEY_HEX=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS

# O JSON deve conter uma conta por igreja e caminhos de certificados mTLS existentes.
EFI_CONFIG_PATH=/run/secrets/efi-accounts.json
EFI_TLS_CERT_PATH=/run/secrets/efi-server.crt
EFI_TLS_KEY_PATH=/run/secrets/efi-server.key
EFI_WEBHOOK_CA_PATH=/run/secrets/efi-ca.crt

# Transporte externo: tokens de saída e callback precisam ser diferentes.
COMMUNICATION_TRANSPORT=webhook
COMMUNICATION_EMAIL_WEBHOOK=https://provider.example.invalid/email
COMMUNICATION_SMS_WEBHOOK=https://provider.example.invalid/sms
COMMUNICATION_WEBHOOK_TOKEN=REPLACE_WITH_OUTPUT_TOKEN
COMMUNICATION_CALLBACK_TOKEN=REPLACE_WITH_CALLBACK_TOKEN

RUN_INTEGRATION_WORKER=false
